<%= link_to link.url,
    rel: "nofollow",
    class: "block tome p-5 group transition-transform duration-200" do %>
  <article>
    <div class="flex items-baseline justify-between gap-3">
      <h2 class="font-engraved text-base sm:text-lg uppercase tracking-[0.12em] text-grim-shadow dark:text-grim-bone group-hover:text-grim-blood dark:group-hover:text-grim-ember flex items-center gap-2 leading-snug">
        <span class="text-grim-blood dark:text-grim-gold">✦</span>
        <%= link.title %>
        <svg class="w-4 h-4 text-grim-shadow/60 dark:text-grim-gold/70" viewBox="0 0 16 16" fill="currentColor"><path d="M6 1h9v9h-2V4.4L4.7 12.7 3.3 11.3 11.6 3H6V1z"/><path d="M1 3h4v2H3v8h8v-2h2v4H1V3z"/></svg>
      </h2>
      <time class="font-plex text-xs uppercase tracking-[0.16em] text-grim-shadow/70 dark:text-grim-gold/80 shrink-0">
        <%= link.created_at.strftime("%Y · %m · %d") %>
      </time>
    </div>
    <% if link.description.present? %>
      <p class="mt-3 font-manuscript text-grim-ink dark:text-grim-bone">
        <%= link.description %>
      </p>
    <% end %>
  </article>
<% end %>
<% if authenticated? %>
<div class="flex gap-2 mt-2 justify-end">
    <%= link_to edit_link_path(link), class: "icon-rune" do %>
        <%= render "shared/icons/pencil", class: "w-4 h-4" %>
    <% end %>
    <%= button_to link_path(link),
        method: :delete,
        class: "icon-rune",
        form: { data: { turbo_confirm: "Banish this binding?" } } do %>
        <%= render "shared/icons/trash", class: "w-4 h-4" %>
    <% end %>
</div>
<% end %>
