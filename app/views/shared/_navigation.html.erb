<header class="content-layer relative">
  <%# Hairline gold rule beneath the masthead; double-line, illuminated %>
  <div class="absolute inset-x-0 bottom-0 h-[5px] pointer-events-none"
       style="background: linear-gradient(180deg, transparent 0 1px, #c8a44d 1px 2px, transparent 2px 3px, #c8a44d 3px 4px, transparent 4px 5px);"></div>

  <div class="container mx-auto px-4 pt-10 pb-8 max-w-5xl">

    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-8">
      <%= link_to root_path, class: "group inline-block" do %>
        <div class="inline-flex items-baseline gap-2 mb-2">
          <span class="font-plex text-xs uppercase tracking-[0.32em] text-grim-blood dark:text-grim-ember">$</span>
          <span class="font-plex text-xs uppercase tracking-[0.32em] text-grim-shadow dark:text-grim-gold">cat ./codex_of</span>
        </div>
        <h1 class="h-blackletter text-4xl sm:text-5xl md:text-6xl cursor-blink">
          <%= Rails.application.config.site_name %>
        </h1>
        <p class="mt-3 font-plex text-[11px] sm:text-xs uppercase tracking-[0.28em] text-grim-blood dark:text-grim-ember">
          // field notes from over 20 years on the web //
        </p>
      <% end %>
    </div>

    <%# DIVIDER %>
    <div class="rune-divider"><span>//</span><span>NAV</span><span>//</span></div>

    <%# TABLE OF CONTENTS — chapters of the codex %>
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
      <nav class="flex flex-wrap gap-x-5 gap-y-3 items-center">
        <%
          nav_items = [
            ["I",   "Home",          root_path],
            ["II",  "About",         "/p/about"],
            ["III", "Presentations", "/p/presentations"],
            ["IV",  "Projects",      "/p/projects"],
            ["V",   "Links",         links_path]
          ]
        %>
        <% nav_items.each do |numeral, label, path|
             active = current_page?(path)
        %>
          <%= link_to path,
              class: "group inline-flex items-baseline gap-2 font-engraved tracking-[0.18em] uppercase text-sm transition-colors duration-150 #{active ? 'text-grim-blood dark:text-grim-ember' : 'text-grim-shadow dark:text-grim-bone hover:text-grim-blood dark:hover:text-grim-ember'}" do %>
            <span class="font-blackletter text-base opacity-70 group-hover:opacity-100"><%= numeral %>.</span>
            <span class="<%= active ? 'underline decoration-grim-blood dark:decoration-grim-gold underline-offset-[6px] decoration-1' : 'group-hover:underline group-hover:decoration-dotted group-hover:underline-offset-[6px] group-hover:decoration-1' %>"><%= label %></span>
            <% if active %><span class="text-grim-blood dark:text-grim-ember">◂</span><% end %>
          <% end %>
        <% end %>
      </nav>

      <div class="flex items-center gap-2">
        <% if content_for? :rss_button %>
          <%= yield :rss_button %>
        <% else %>
          <%= link_to blog_feed_path, class: "icon-rune", aria: { label: "Auguries (RSS)" } do %>
            <svg viewBox="0 0 16 16" class="w-4 h-4" fill="currentColor"><path d="M2 12.5a1.5 1.5 0 1 1 3 0 1.5 1.5 0 0 1-3 0zM2 6.5a.5.5 0 0 1 .5-.5 7.5 7.5 0 0 1 7.5 7.5.5.5 0 0 1-1 0A6.5 6.5 0 0 0 2.5 7a.5.5 0 0 1-.5-.5zM2 2.5A.5.5 0 0 1 2.5 2a11.5 11.5 0 0 1 11.5 11.5.5.5 0 0 1-1 0A10.5 10.5 0 0 0 2.5 3a.5.5 0 0 1-.5-.5z"/></svg>
          <% end %>
        <% end %>
        <button onclick="toggleDarkMode()" class="icon-rune" aria-label="Toggle nightfall">
          <span class="dark:hidden">
            <svg viewBox="0 0 16 16" class="w-4 h-4" fill="currentColor"><path d="M11.2 1c-3.3 0-6 2.7-6 6 0 .9.2 1.8.6 2.6C3.4 9.2 1.6 7 1.6 4.3c0-.2 0-.4.1-.6A6 6 0 0 0 7 14c3.3 0 6-2.7 6-6 0-.3 0-.6-.1-.9.7-.4 1.5-.7 2.5-.7.1 0 .2-.1.2-.2 0-.1-.1-.2-.2-.2-1.5 0-2.9.6-4 1.5C11.4 5.2 11.4 3.2 11.2 1z"/></svg>
          </span>
          <span class="hidden dark:inline">
            <svg viewBox="0 0 16 16" class="w-4 h-4" fill="currentColor"><circle cx="8" cy="8" r="3"/><path d="M8 0v2M8 14v2M0 8h2M14 8h2M2.3 2.3l1.4 1.4M12.3 12.3l1.4 1.4M2.3 13.7l1.4-1.4M12.3 3.7l1.4-1.4" stroke="currentColor" stroke-width="1.4"/></svg>
          </span>
        </button>
      </div>
    </div>
  </div>
</header>
