<%
  def to_roman(num)
    table = [
      [1000,'M'],[900,'CM'],[500,'D'],[400,'CD'],
      [100,'C'],[90,'XC'],[50,'L'],[40,'XL'],
      [10,'X'],[9,'IX'],[5,'V'],[4,'IV'],[1,'I']
    ]
    out = +""
    n = num.to_i
    table.each { |v,r| while n >= v; out << r; n -= v; end }
    out
  end
%>

<div class="mb-10 text-center">
  <p class="font-engraved tracking-[0.32em] uppercase text-xs text-grim-shadow dark:text-grim-gold">// folio · transmissions //</p>
  <h1 class="h-blackletter text-4xl sm:text-5xl mt-3 mb-2">Recent Inscriptions</h1>
  <div class="rune-divider mt-4"><span>//</span><span>LOG</span><span>//</span></div>
</div>

<div class="space-y-12">
  <% @posts.each_with_index do |post, idx| %>
    <article class="tome relative">

      <%# Page-number tag in the corner — Folio + Roman numeral year %>
      <div class="absolute -top-5 right-6 flex items-center gap-2 font-engraved text-[10px] uppercase tracking-[0.28em] bg-grim-vellum dark:bg-grim-tomb text-grim-blood dark:text-grim-gold border border-grim-shadow dark:border-grim-gold px-3 py-1 shadow-sm">
        <span class="text-grim-gold dark:text-grim-ember">✦</span>
        <span>Folio · Anno&nbsp;<%= to_roman(post.created_at.year) %></span>
      </div>

      <h2 class="h-blackletter text-3xl sm:text-4xl leading-tight mb-3 mt-1">
        <%= link_to post.title, dated_post_path(year: post.year, day: post.day, month: post.month, id: post),
            class: "hover:text-grim-ember transition-colors duration-200" %>
      </h2>

      <p class="font-engraved text-xs uppercase tracking-[0.22em] text-grim-shadow dark:text-grim-gold mb-5">
        ✦ <%= post.created_at.strftime('%B %d, %Y') %> &nbsp;·&nbsp; chapter <%= to_roman(idx + 1) %>
      </p>

      <div class="font-manuscript text-grim-ink dark:text-grim-bone leading-relaxed mb-5 text-[1.08rem]">
        <%= post.rendered_excerpt.html_safe %>
      </div>

      <div class="flex flex-wrap gap-2 my-5">
        <%= render "shared/tags", post: post %>
      </div>

      <div class="mt-6 flex items-center gap-4 flex-wrap">
        <%= link_to dated_post_path(year: post.year, day: post.day, month: post.month, id: post),
            class: "spell-btn spell-btn-blood" do %>
          ✦ open spellbook
        <% end %>
        <% if authenticated? %>
          <%= link_to "redact ▸", edit_post_path(post),
              class: "arc-link font-plex text-sm" %>
        <% end %>
      </div>
    </article>
  <% end %>

  <div class="pt-6"><%= paginate @posts %></div>
</div>
