<%
  def to_roman(num)
    table = [
      [1000,'M'],[900,'CM'],[500,'D'],[400,'CD'],
      [100,'C'],[90,'XC'],[50,'L'],[40,'XL'],
      [10,'X'],[9,'IX'],[5,'V'],[4,'IV'],[1,'I']
    ]
    out = +""
    n = num.to_i
    table.each { |v,r| while n >= v; out << r; n -= v; end }
    out
  end
%>

<% content_for :title do %>
  #<%= @tag.name %> | <%= Rails.application.config.site_name %>
<% end %>

<% content_for :rss do %>
  <%= auto_discovery_link_tag(:atom, tag_feed_path(id: @tag.name)) %>
<% end %>

<% content_for :rss_button do %>
  <%= link_to tag_feed_path(id: @tag.name), class: "icon-rune", aria: { label: "Auguries (RSS)" } do %>
    <svg viewBox="0 0 16 16" class="w-4 h-4" fill="currentColor"><path d="M2 12.5a1.5 1.5 0 1 1 3 0 1.5 1.5 0 0 1-3 0zM2 6.5a.5.5 0 0 1 .5-.5 7.5 7.5 0 0 1 7.5 7.5.5.5 0 0 1-1 0A6.5 6.5 0 0 0 2.5 7a.5.5 0 0 1-.5-.5zM2 2.5A.5.5 0 0 1 2.5 2a11.5 11.5 0 0 1 11.5 11.5.5.5 0 0 1-1 0A10.5 10.5 0 0 0 2.5 3a.5.5 0 0 1-.5-.5z"/></svg>
  <% end %>
<% end %>

<div class="space-y-12">

  <%# BANNER — sigil + invocation %>
  <div class="tome p-8 md:p-10 text-center">
    <p class="font-engraved text-[10px] uppercase tracking-[0.32em] text-grim-blood dark:text-grim-ember mb-3">// summoned by sigil</p>
    <h1 class="h-blackletter text-5xl sm:text-6xl mb-3">
      <span class="text-grim-shadow dark:text-grim-gold">#</span><%= @tag.name %>
    </h1>
    <p class="font-engraved uppercase tracking-[0.22em] text-xs text-grim-shadow dark:text-grim-gold">
      ✦ <%= pluralize(@posts.total_count, 'inscription') %> bound to this rune ✦
    </p>
    <div class="rune-divider mt-5"><span>//</span><span>FILTER</span><span>//</span></div>
  </div>

  <% @posts.each_with_index do |post, idx| %>
    <article class="tome relative">

      <div class="absolute -top-5 right-6 flex items-center gap-2 font-engraved text-[10px] uppercase tracking-[0.28em] bg-grim-vellum dark:bg-grim-tomb text-grim-blood dark:text-grim-gold border border-grim-shadow dark:border-grim-gold px-3 py-1 shadow-sm">
        <span class="text-grim-gold dark:text-grim-ember">✦</span>
        <span>Folio · Anno&nbsp;<%= to_roman(post.created_at.year) %></span>
      </div>

      <h2 class="h-blackletter text-2xl sm:text-3xl mb-3 mt-1">
        <%= link_to post.title, dated_post_path(year: post.year, day: post.day, month: post.month, id: post),
            class: "hover:text-grim-ember transition-colors" %>
      </h2>

      <p class="font-engraved text-xs uppercase tracking-[0.22em] text-grim-shadow dark:text-grim-gold mb-5">
        ✦ <%= post.created_at.strftime('%B %d, %Y') %>
      </p>

      <div class="font-manuscript text-grim-ink dark:text-grim-bone leading-relaxed mb-5">
        <%= post.rendered_excerpt.html_safe %>
      </div>

      <div class="flex flex-wrap gap-2 my-5">
        <%= render "shared/tags", post: post %>
      </div>

      <div class="mt-6 flex items-center gap-4 flex-wrap">
        <%= link_to dated_post_path(year: post.year, day: post.day, month: post.month, id: post),
            class: "spell-btn spell-btn-blood" do %>
          ✦ open spellbook
        <% end %>
        <% if authenticated? %>
          <%= link_to "redact ▸", edit_post_path(post), class: "arc-link font-plex text-sm" %>
        <% end %>
      </div>
    </article>
  <% end %>

  <div class="pt-6"><%= paginate @posts %></div>
</div>
